{
  "name": "reed",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "web": "npm run web -w @reed/app",
    "ios": "npm run ios -w @reed/app",
    "android": "npm run android -w @reed/app",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts",
    "db:test:auth": "node --test supabase/tests/integration/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  }
}
